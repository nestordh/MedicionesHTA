CREATE DATABASE hta_medicion;

USE hta_medicion;

CREATE TABLE usuarios(
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario VARCHAR(50) UNIQUE,
    password VARCHAR(255)
);

CREATE TABLE mediciones(
    id INT AUTO_INCREMENT PRIMARY KEY,
    fecha DATE,
    hora TIME,
    sistolica INT,
    diastolica INT,
    pulsaciones INT,
    glucosa INT,
    usuario_id INT NOT NULL,
    registrado_por INT NOT NULL,
    observacion TEXT,
    CONSTRAINT fk_mediciones_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios(id),
    CONSTRAINT fk_mediciones_registrador
        FOREIGN KEY (registrado_por) REFERENCES usuarios(id)
);

ALTER TABLE mediciones
ADD INDEX idx_usuario_id(usuario_id);

ALTER TABLE mediciones
ADD INDEX idx_fecha(fecha);

ALTER TABLE mediciones
ADD INDEX idx_sistolica(sistolica);

ALTER TABLE mediciones
ADD INDEX idx_diastolica(diastolica);