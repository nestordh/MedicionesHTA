QMainWindow
{
    background-color: #1e1e1e;
}

QWidget
{
    background-color: #1e1e1e;
    color: #ffffff;
    font-size: 10pt;
}

QLineEdit,
QComboBox,
QSpinBox,
QDateEdit,
QTimeEdit,
QTextEdit,
QTableWidget
{
    background-color: #2d2d30;
    border: 1px solid #444;
    border-radius: 6px;
    color: white;
    padding: 4px;
}

QPushButton
{
    background-color: #0078d7;
    color: white;
    border-radius: 8px;
    padding: 6px;
}

QPushButton:hover
{
    background-color: #1a8cff;
}

QHeaderView::section
{
    background-color: #333;
    color: white;
}